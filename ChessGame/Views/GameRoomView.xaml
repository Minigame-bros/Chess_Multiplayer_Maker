<UserControl x:Class="ChessGame.Views.GameRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChessGame.Views"
             xmlns:vm="clr-namespace:ChessGame.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800" Background="#222">
             
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <!-- Board Area -->
        <Border Grid.Column="0" BorderBrush="#555" BorderThickness="2" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Row Labels (Left) -->
                <ItemsControl Grid.Row="0" Grid.Column="0" ItemsSource="{Binding RowLabels}" Width="30">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="8" Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="White" FontSize="16" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Chess Board -->
                <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Squares}" Width="575" Height="575">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="8" Columns="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="SquareBorder" Background="{Binding Background}" BorderThickness="0" Margin="0">
                                <Button Command="{Binding DataContext.SquareClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                        CommandParameter="{Binding}" 
                                        Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <!-- Highlight circle for valid moves -->
                                        <Ellipse x:Name="HighlightCircle" Fill="#8020C820" Width="24" Height="24" Visibility="{Binding IsHighlighted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <!-- Piece text -->
                                        <TextBlock Text="{Binding PieceText}" Foreground="{Binding PieceColor}" 
                                                   FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Symbol"/>
                                    </Grid>
                                </Button>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="SquareBorder" Property="BorderBrush" Value="Yellow" />
                                    <Setter TargetName="SquareBorder" Property="BorderThickness" Value="3" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Column Labels (Bottom) -->
                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ColumnLabels}" Height="30">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="White" FontSize="16" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        <!-- Sidebar for settings & info -->
        <Border Grid.Column="1" Background="#333" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Settings & Leave Room Menu -->
                    <RowDefinition Height="Auto"/> <!-- Status Text -->
                    <RowDefinition Height="Auto"/> <!-- Start Game Button -->
                    <RowDefinition Height="Auto"/> <!-- Return to game button -->
                    <RowDefinition Height="Auto"/> <!-- History Header -->
                    <RowDefinition Height="*"/>    <!-- Move History -->
                    <RowDefinition Height="Auto"/> <!-- Chat Header -->
                    <RowDefinition Height="150"/>  <!-- Chat Messages -->
                    <RowDefinition Height="Auto"/> <!-- Chat Input -->
                </Grid.RowDefinitions>

                <!-- Top Bar: Options -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <ToggleButton x:Name="SettingsToggle" Grid.Column="0" Content="⚙️" FontSize="18" Padding="5" Background="Transparent" Foreground="White" BorderThickness="0" ToolTip="Cài đặt bàn cờ"/>
                    
                    <Popup IsOpen="{Binding IsChecked, ElementName=SettingsToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Bottom">
                        <Border Background="#444" BorderBrush="#555" BorderThickness="1" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Màu ô sáng (Hex):" Foreground="White" Margin="0,0,0,5"/>
                                <ComboBox SelectedIndex="{Binding SelectedThemeIndex}">
                                    <ComboBoxItem Content="Gỗ Cổ điển" />
                                    <ComboBoxItem Content="Xanh lá/Trắng" />
                                    <ComboBoxItem Content="Xám/Trắng" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Grid.Column="2" Content="Thoát phòng" Command="{Binding LeaveRoomCommand}" Background="#d9534f" Foreground="White" Padding="10,5" FontWeight="Bold" ToolTip="Thoát khỏi phòng chơi"/>
                </Grid>
                
                <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="LightGray" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,10"/>
                
                <!-- Start / Play Again Button -->
                <Button Grid.Row="2" Content="{Binding StartButtonText}" Command="{Binding StartGameCommand}" Background="#5cb85c" Foreground="White" Padding="5" Margin="0,0,0,10" FontWeight="Bold" Visibility="{Binding CanStartGame, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Return to game button (visible when viewing history) -->
                <Button Grid.Row="3" Content="Quay lại ván cờ chính" Command="{Binding ReturnToCurrentGameCommand}" Background="#0275d8" Foreground="White" Padding="5" Margin="0,0,0,10" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsViewingHistory}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Row="4" Text="Biên bản ván cờ" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                
                <!-- History ItemsControl (Two Columns) -->
                <ScrollViewer Grid.Row="5" Background="#222" Margin="0,0,0,10">
                    <ItemsControl ItemsSource="{Binding MoveHistory}" Foreground="White" BorderThickness="1" BorderBrush="#555">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayTurnNumber}" FontSize="14" Foreground="LightGray" VerticalAlignment="Center"/>
                                    
                                    <Button Grid.Column="1" Content="{Binding WhiteMove.SanNotation}" Command="{Binding DataContext.ReviewMoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding WhiteMove}" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalAlignment="Left">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WhiteMove}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    
                                    <Button Grid.Column="2" Content="{Binding BlackMove.SanNotation}" Command="{Binding DataContext.ReviewMoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding BlackMove}" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalAlignment="Left">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlackMove}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="6" Text="Chat" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,20,0,10"
                           Visibility="{Binding IsMultiplayerMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                
                <ScrollViewer Grid.Row="7" Background="#222" Margin="0,0,0,10"
                              Visibility="{Binding IsMultiplayerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="White" TextWrapping="Wrap" Margin="5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <Grid Grid.Row="8" Visibility="{Binding IsMultiplayerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendChatCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Gửi" Command="{Binding SendChatCommand}" Padding="10,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
